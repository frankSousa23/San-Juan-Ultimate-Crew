# ===================================================================
# SIGEDIVO - Variables de Entorno para Producción / Hosting
# ===================================================================

# Entorno de ejecución (production | development)
NODE_ENV=production

# Puerto del servidor (por defecto 3000 o 4000 según tu configuración de hosting)
PORT=3000

# URL de conexión a la base de datos PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL=postgresql://sju_user:tu_password_seguro@localhost:5432/sju_prod?schema=public

# Clave secreta para firmar tokens JWT (Mínimo 32 caracteres en producción)
# Ejemplo: Puedes generar una con: openssl rand -base64 32
JWT_SECRET=tu_clave_secreta_super_segura_de_al_menos_32_caracteres_12345

# Tiempo de expiración de los tokens de acceso y refresco
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Requiere autenticación estricta en la API (true en producción)
AUTH_REQUIRED=true

# Origen permitido para CORS (dominio donde corre el frontend)
# Ejemplo: https://sigedivo.tudominio.com o * para permitir todos
CORS_ORIGIN=*

# URL base del frontend para redirecciones y correos
FRONTEND_URL=http://localhost:3000

# Nivel de registro de logs (error, warn, info, debug)
LOG_LEVEL=info

# URL de la API consumida por el cliente web (si el frontend se despliega por separado)
# Si el servidor Express sirve tanto API como Frontend en el mismo dominio, déjalo vacío o usa /api
VITE_API_URL=
