# =============================================================================
# SIGEDIVO (Web Client) — Plantilla de Variables de Entorno & White-Label
# =============================================================================

# Base URL para el servidor backend API (en desarrollo suele ser http://localhost:3000/api)
VITE_API_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# Personalización de Marca Blanca (White-Label Branding)
# -----------------------------------------------------------------------------

# Nombre oficial y completo de la organización anfitriona
# Ejemplo Club: "El Pueblito Ultimate Club"
# Ejemplo Asociación: "Asociación Guariqueña del Disco Volador"
VITE_ORG_NAME="Club Deportivo de Ultimate Frisbee"

# Nombre corto o acrónimo para barras de navegación y vistas móviles
# Ejemplo Club: "El Pueblito"
# Ejemplo Asociación: "AGDV"
VITE_ORG_SHORT_NAME="Club"

# Título de la pestaña de la aplicación en el navegador
# Ejemplo: "El Pueblito Ultimate • SIGEDIVO"
VITE_APP_TITLE="SIGEDIVO • Gestión Deportiva"

# Tipo de organización: "CLUB" | "ASSOCIATION" | "ACADEMY" | "LEAGUE"
VITE_ORG_TYPE="CLUB"

# Color primario de énfasis (código hexadecimal)
# Verde Esmeralda: #059669 | Azul Deportivo: #0284c7 | Rojo / Carmesí: #dc2626
VITE_PRIMARY_COLOR="#059669"

# Ruta o URL pública al escudo o logotipo del club
VITE_LOGO_URL="/logo.png"

# Correo electrónico de contacto o soporte del club
VITE_CONTACT_EMAIL="contacto@tuclub.com"

# Ubicación sede (Ciudad, Estado / Región)
VITE_ORG_LOCATION="San Juan de los Morros, Guárico"
