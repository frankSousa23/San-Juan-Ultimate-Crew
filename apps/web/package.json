{
  "name": "@sigedivo/web",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "api:dev": "npm --prefix ../api run dev",
    "lint": "eslint src",
