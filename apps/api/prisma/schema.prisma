generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayerPosition {
  HANDLER
  CUTTER
  HYBRID
}

enum PlayerStatus {
  ACTIVE
  INJURED
  INACTIVE
}

enum EventType {
  TRAINING
  TOURNAMENT
  SOCIAL
  WORKSHOP
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// Injuries
enum InjurySeverity {
  MILD
  MODERATE
  SEVERE
}

enum InjuryStatus {
  ACTIVE
  RECOVERING
  RESOLVED
}

// Plays
enum PlayCategory {
  OFFENSE
  DEFENSE
  DRILL
}

// Finance
enum AccountType {
  CASH
  BANK
  MOBILE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

// Role Requests
enum RoleRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model Player {
  id         Int            @id @default(autoincrement())
  name       String
  number     Int             @unique
  position   PlayerPosition
  status     PlayerStatus    @default(ACTIVE)
  heightCm   Int?
  experience String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  messages   Message[]
  attendances Attendance[]
  eventParticipants EventParticipant[]
  injuries   Injury[]

  // Reverse relation to User (one-to-one)
  user       User?          @relation("PlayerUser")

  // Reverse relation to RoleRequest.player
  roleRequests RoleRequest[]
}

model Event {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  type        EventType
  status      EventStatus   @default(UPCOMING)
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  participants EventParticipant[]
  attendances  Attendance[]
  channel      Channel?

  @@index([startsAt])
  @@index([type])
  @@index([status])
}

model EventParticipant {
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int
  player  Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int
  role    String?
  status  String? // confirmed, tentative, declined

  @@id([eventId, playerId])
}

model Channel {
  id        Int       @id @default(autoincrement())
  name      String
  eventId   Int?      @unique
  createdAt DateTime  @default(now())
  messages  Message[]

  event     Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Message {
  id        Int       @id @default(autoincrement())
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId Int
  author    Player?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  Int?
  content   String
  createdAt DateTime  @default(now())

  @@index([channelId, createdAt])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  status    String   // present, absent, late
  note      String?
  createdAt DateTime @default(now())

  @@unique([playerId, eventId])
}

model Account {
  id        Int          @id @default(autoincrement())
  name      String
  type      AccountType
  createdAt DateTime      @default(now())
  transactions Transaction[]
}

model Category {
  id        Int             @id @default(autoincrement())
  name      String
  kind      TransactionType
  createdAt DateTime         @default(now())
  transactions Transaction[]
}

model Transaction {
  id          Int             @id @default(autoincrement())
  account     Account         @relation(fields: [accountId], references: [id])
  accountId   Int
  category    Category?       @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  type        TransactionType
  amountCents Int
  occurredAt  DateTime
  description String?
  createdAt   DateTime        @default(now())

  @@index([occurredAt])
  @@index([accountId, occurredAt])
}

model Injury {
  id          Int            @id @default(autoincrement())
  player      Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId    Int
  type        String
  severity    InjurySeverity
  status      InjuryStatus   @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime       @default(now())

  @@index([playerId])
  @@index([status])
  @@index([severity])
}

model Rival {
  id            Int       @id @default(autoincrement())
  name          String
  strengths     String?
  weaknesses    String?
  lastPlayedAt  DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([name])
}

model Play {
  id          Int          @id @default(autoincrement())
  name        String
  category    PlayCategory
  description String?
  diagramUrl  String?
  content     String?      // Markdown o JSON
  createdAt   DateTime     @default(now())

  @@index([category])
  @@index([name])
}

model Resource {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  url         String?
  category    String?
  // File metadata (for uploaded resources)
  fileName    String?
  mimeType    String?
  size        Int?
  storagePath String?
  createdAt   DateTime  @default(now())

  @@index([category])
  @@index([title])
}

// Auth & RBAC

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String?
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         UserRole[]
  playerId      Int?
  player        Player?   @relation("PlayerUser", fields: [playerId], references: [id], onDelete: SetNull)

  roleRequests  RoleRequest[]
  // Reverse relation to RoleRequest.decidedBy
  decidedRequests RoleRequest[] @relation("RoleRequestDecider")

  @@unique([playerId])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  createdAt   DateTime     @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  createdAt DateTime         @default(now())
  roles     RolePermission[]
}

model UserRole {
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId Int

  @@id([userId, roleId])
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId Int

  @@id([roleId, permissionId])
}

model RoleRequest {
  id           Int               @id @default(autoincrement())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  role         String            // requested role, currently only 'player' allowed by API
  player       Player?           @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerId     Int?
  status       RoleRequestStatus @default(PENDING)
  note         String?
  decidedBy    User?             @relation("RoleRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById  Int?
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?

  @@index([status])
  @@index([userId])
}
