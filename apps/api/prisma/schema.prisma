generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayerPosition {
  HANDLER
  CUTTER
  HYBRID
}

enum PlayerStatus {
  ACTIVE
  INJURED
  INACTIVE
}

enum EventType {
  TRAINING
  TOURNAMENT
  SOCIAL
  WORKSHOP
  FULL_DAY_OPEN
  FULL_DAY_MIXTO
  AMISTOSO
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// Injuries
enum InjurySeverity {
  MILD
  MODERATE
  SEVERE
}

enum InjuryStatus {
  ACTIVE
  RECOVERING
  RESOLVED
}

// Plays
enum PlayCategory {
  OFFENSE
  DEFENSE
  DRILL
}

// Event Annotations
enum AnnotationType {
  GOAL
  ASSIST
  DEFENSE
  TURNOVER
  DROP
  FOUL
  TIMEOUT
  SUBSTITUTION
  INJURY
  GENERAL
  STRATEGY
  PERFORMANCE
  CALLAHAN
  GREATEST
}

// Finance
enum AccountType {
  CASH
  BANK
  MOBILE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

// Role Requests
enum RoleRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// User Status
enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model Player {
  id         Int            @id @default(autoincrement())
  name       String
  number     Int            @unique
  position   PlayerPosition
  status     PlayerStatus   @default(ACTIVE)
  heightCm   Int?
  experience String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  messages          Message[]
  attendances       Attendance[]
  eventParticipants EventParticipant[]
  injuries          Injury[]
  annotations       EventAnnotation[]
  newsPosts         NewsPost[]
  matchStats        PlayerMatchStats[]

  // Reverse relation to User (one-to-one)
  user User? @relation("PlayerUser")

  // Reverse relation to RoleRequest.player
  roleRequests RoleRequest[]

  @@index([status])
  @@index([position])
  @@index([number])
}

model Event {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  type        EventType
  status      EventStatus @default(UPCOMING)
  location    String?
  startsAt    DateTime
  endsAt      DateTime?

  // Ultimate Frisbee Specific Fields
  windSpeed     Int? // km/h
  windDirection String? // "N", "NE", "Crosswind", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants EventParticipant[]
  attendances  Attendance[]
  annotations  EventAnnotation[]
  channel      Channel?

  // Tournaments integration (Event Hierarchy)
  parentId Int?
  parent   Event?  @relation("EventHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Event[] @relation("EventHierarchy")

  // Statistics
  matchStats   PlayerMatchStats[]
  spiritScores SpiritScore[]

  @@index([startsAt])
  @@index([type])
  @@index([status])
  @@index([parentId])
}

model SpiritScore {
  id               Int      @id @default(autoincrement())
  eventId          Int
  evaluatorTeamId  Int? // If we are evaluating or being evaluated (null = we evaluate them)
  rulesKnowledge   Int      @default(0) // 0-4
  foulsAndContact  Int      @default(0) // 0-4
  fairMindedness   Int      @default(0) // 0-4
  positiveAttitude Int      @default(0) // 0-4
  communication    Int      @default(0) // 0-4
  comment          String?
  createdAt        DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model PlayerMatchStats {
  id       Int    @id @default(autoincrement())
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  Int

  // Statistical fields
  goals        Int @default(0)
  assists      Int @default(0)
  defenses     Int @default(0)
  turnovers    Int @default(0)
  drops        Int @default(0)
  pointsPlayed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, eventId])
  @@index([eventId])
  @@index([playerId])
}

model EventParticipant {
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  Int
  player   Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId Int
  role     String?
  status   String? // confirmed, tentative, declined
  lineType String? // O-Line, D-Line, Flex

  @@id([eventId, playerId])
  @@index([eventId])
  @@index([playerId])
}

model Channel {
  id        Int       @id @default(autoincrement())
  name      String
  eventId   Int?      @unique
  createdAt DateTime  @default(now())
  messages  Message[]

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Message {
  id        Int      @id @default(autoincrement())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId Int
  author    Player?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  Int?
  content   String
  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  status    String // present, absent, late
  note      String?
  createdAt DateTime @default(now())

  @@unique([playerId, eventId])
  @@index([eventId])
  @@index([playerId])
}

model EventAnnotation {
  id        Int            @id @default(autoincrement())
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  player    Player?        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  Int? // Nullable para soportar jugadores oponentes
  type      AnnotationType
  note      String? // Descripción detallada de la anotación
  timestamp DateTime       @default(now()) // Momento en que ocurrió durante el evento
  category  String? // Para FULL_DAY: "OPEN" o "MIXTO", null para otros tipos
  createdBy Int? // Usuario que creó la anotación (opcional, para auditoría)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Campos para jugadores oponentes (versus)
  rival                Rival?       @relation(fields: [rivalId], references: [id], onDelete: SetNull)
  rivalId              Int? // Relación directa con Rival
  opponentTeamName     String? // Nombre del equipo oponente (puede ser diferente del nombre del rival)
  opponentPlayerName   String? // Nombre del jugador oponente (si no está en nuestro roster)
  opponentPlayerNumber Int? // Número del jugador oponente
  rivalPlayerId        Int? // Relación con RivalPlayer si existe
  rivalPlayer          RivalPlayer? @relation(fields: [rivalPlayerId], references: [id], onDelete: SetNull)
  teamSide             String? // "HOME" o "AWAY" - para identificar qué equipo
  scoreHome            Int? // Puntos del equipo local en ese momento
  scoreAway            Int? // Puntos del equipo visitante en ese momento

  @@index([eventId])
  @@index([playerId])
  @@index([eventId, playerId])
  @@index([type])
  @@index([timestamp])
  @@index([eventId, timestamp])
  @@index([opponentTeamName])
  @@index([rivalId])
  @@index([rivalPlayerId])
}

model Account {
  id           Int           @id @default(autoincrement())
  name         String
  type         AccountType
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Category {
  id           Int             @id @default(autoincrement())
  name         String
  kind         TransactionType
  createdAt    DateTime        @default(now())
  transactions Transaction[]
}

model Transaction {
  id          Int             @id @default(autoincrement())
  account     Account         @relation(fields: [accountId], references: [id])
  accountId   Int
  category    Category?       @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  type        TransactionType
  amountCents Int
  occurredAt  DateTime
  description String?
  createdAt   DateTime        @default(now())

  @@index([occurredAt])
  @@index([accountId, occurredAt])
  @@index([type])
  @@index([categoryId])
  @@index([type, occurredAt])
}

model Injury {
  id          Int            @id @default(autoincrement())
  player      Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId    Int
  type        String
  severity    InjurySeverity
  status      InjuryStatus   @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime       @default(now())

  @@index([playerId])
  @@index([status])
  @@index([severity])
  @@index([playerId, status])
  @@index([startDate])
}

model Rival {
  id           Int       @id @default(autoincrement())
  name         String
  strengths    String?
  weaknesses   String?
  lastPlayedAt DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  // Relación con jugadores del rival
  players     RivalPlayer[]
  // Relación con anotaciones (a través de opponentTeamName)
  annotations EventAnnotation[]

  @@index([name])
}

model RivalPlayer {
  id        Int      @id @default(autoincrement())
  rival     Rival    @relation(fields: [rivalId], references: [id], onDelete: Cascade)
  rivalId   Int
  name      String
  number    Int
  position  String? // Posición del jugador (opcional)
  notes     String? // Notas adicionales sobre el jugador
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con anotaciones
  annotations EventAnnotation[]

  @@unique([rivalId, number]) // Un número único por rival
  @@index([rivalId])
  @@index([name])
}

model Play {
  id          Int          @id @default(autoincrement())
  name        String
  category    PlayCategory
  description String?
  diagramUrl  String?
  content     String? // Markdown o JSON
  createdAt   DateTime     @default(now())

  @@index([category])
  @@index([name])
  @@index([createdAt])
  @@index([category, createdAt])
}

model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  url         String?
  category    String?
  // File metadata (for uploaded resources)
  fileName    String?
  mimeType    String?
  size        Int?
  storagePath String?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([title])
  @@index([createdAt])
  @@index([category, createdAt])
}

// News Posts (Noticias/Foro)
model NewsPost {
  id          Int       @id @default(autoincrement())
  title       String
  content     String // Contenido del post (Markdown o texto)
  author      Player?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    Int?
  isPinned    Boolean   @default(false) // Post fijado
  isPublished Boolean   @default(true) // Publicado o borrador
  category    String? // Categoría del post (ej: "Anuncios", "Eventos", "General")
  views       Int       @default(0) // Contador de vistas
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime? // Fecha de publicación (si es borrador)

  files NewsPostFile[]

  @@index([authorId])
  @@index([isPublished])
  @@index([isPinned])
  @@index([category])
  @@index([createdAt])
  @@index([isPublished, createdAt])
  @@index([isPinned, createdAt])
}

model NewsPostFile {
  id           Int      @id @default(autoincrement())
  post         NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       Int
  fileName     String
  originalName String // Nombre original del archivo
  mimeType     String
  size         Int // Tamaño en bytes
  storagePath  String // Ruta de almacenamiento
  description  String? // Descripción opcional del archivo
  createdAt    DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
}

// Auth & RBAC

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String?
  passwordHash String
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles    UserRole[]
  playerId Int?
  player   Player?    @relation("PlayerUser", fields: [playerId], references: [id], onDelete: SetNull)

  roleRequests    RoleRequest[]
  // Reverse relation to RoleRequest.decidedBy
  decidedRequests RoleRequest[]        @relation("RoleRequestDecider")
  auditLogs       AuditLog[]
  passwordResets  PasswordResetToken[]

  @@unique([playerId])
  @@index([status])
  @@index([email])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  createdAt DateTime         @default(now())
  roles     RolePermission[]
}

model UserRole {
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId Int

  @@id([userId, roleId])
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId Int

  @@id([roleId, permissionId])
}

model RoleRequest {
  id          Int               @id @default(autoincrement())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  role        String // requested role, currently only 'player' allowed by API
  player      Player?           @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerId    Int?
  status      RoleRequestStatus @default(PENDING)
  note        String?
  decidedBy   User?             @relation("RoleRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById Int?
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?

  @@index([status])
  @@index([userId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ROLE_CHANGE
  PERMISSION_CHANGE
  FILE_UPLOAD
  FILE_DELETE
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  action     AuditAction
  entityType String // e.g., "User", "Transaction", "Resource", "Player"
  entityId   Int?
  userId     Int?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  details    String? // JSON string with additional context
  createdAt  DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}
