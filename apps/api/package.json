{
  "name": "@sju/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "wait:health": "node scripts/wait-health.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "lint": "echo \"no lint configured\"",
    "smoke:finance": "tsx scripts/smoke-finance.ts",
    "smoke:e2e": "tsx scripts/smoke-e2e.ts",
  "test:auth": "cross-env AUTH_REQUIRED=true vitest run src/auth.guard.test.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.30",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "prisma": "^5.17.0",
    "supertest": "^7.1.4",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.1"
  },
  "license": "MIT"
}
