{
  "name": "san-juan-ultimate-crew",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm -w apps/api run build && npm -w apps/web run build",
    "start": "npm -w apps/api run start",
    "smoke:e2e": "node apps/api/scripts/smoke-e2e.cjs",
    "dev-menu": "./scripts/dev.sh",
    "setup": "./scripts/create-env-files.sh && ./scripts/setup-dev.sh",
    "check": "./scripts/quick-check.sh",
    "test": "./scripts/test-all.sh",
    "test:impl": "./scripts/test-implementation.sh",
    "diagnose": "./scripts/diagnose.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down && docker compose up -d",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "prisma:migrate": "npm --workspace apps/api run prisma:migrate",
    "prisma:seed": "npm --workspace apps/api run prisma:seed",
    "prisma:reset": "npm --workspace apps/api run prisma:migrate && npm --workspace apps/api run prisma:seed",
    "build:prod": "./scripts/build-optimized.sh",
    "start:prod": "./start-production.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "license": "MIT"
}
