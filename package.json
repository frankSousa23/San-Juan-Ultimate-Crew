{
  "name": "sigedivo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "test": "npm --workspace apps/api run test",
    "test:api": "npm --workspace apps/api run test",
    "lint": "npm -w apps/web run build",
    "build": "npm -w apps/web run build && npm -w apps/api run build && esbuild server.ts --bundle --platform=node --format=cjs --external:bcryptjs --external:pg --external:@prisma/client --external:@prisma/adapter-pg --external:multer --sourcemap --outfile=dist/server.cjs && node -e \"const fs=require('fs'); if(fs.existsSync('apps/web/dist')) { fs.cpSync('apps/web/dist', 'dist', {recursive: true}); fs.mkdirSync('apps/api/dist/web', {recursive: true}); fs.cpSync('apps/web/dist', 'apps/api/dist/web', {recursive: true}); }\"",
    "start": "node dist/server.cjs",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "prisma:seed": "npm --workspace apps/api run prisma:seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "autocannon": "^8.0.0",
    "concurrently": "^10.0.3"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.12",
    "vite": "^6.4.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  }
}
