{
  "name": "san-juan-ultimate-crew",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm -w apps/web run build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "autocannon": "^8.0.0",
    "concurrently": "^10.0.3"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "vite": "^8.2.1"
  }
}
